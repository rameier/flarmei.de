---
import TopicTag from '../components/TopicTag.astro';
import type { BlogPost } from '../lib/posts';
import { estimateReadMinutes, formatDate, getPostSlug } from '../lib/posts';
import BaseLayout from './BaseLayout.astro';

interface Props {
  post: BlogPost;
  nextPost?: BlogPost;
}

const { post, nextPost } = Astro.props;
---

<BaseLayout
  title={`${post.data.title} - flarmei.de`}
  description={post.data.description}
  type="article"
>
  <div class="progress" data-progress></div>
  <article class="fade">
    <header class="post-header">
      <a class="back" href="/blog">&lt;- alle Texte</a>
      <TopicTag topic={post.data.topic} />
      <h1>{post.data.title}</h1>
      <p class="dek">{post.data.description}</p>
      <div class="byline">
        <span class="micro">Ralf Meier</span>
        <time class="micro" datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        <span class="micro">{estimateReadMinutes(post)} min lesen</span>
      </div>
    </header>
    <hr class="hairline" />

    <div class="article">
      <slot />
    </div>
  </article>

  {
    nextPost && (
      <nav class="post-nav" aria-label="Nächster Artikel">
        <hr class="hairline" />
        <article class="row">
          <div class="rdate mono">NEXT</div>
          <div class="rmain">
            <h2 class="rtitle">
              <a href={`/blog/${getPostSlug(nextPost)}`}>{nextPost.data.title}</a>
            </h2>
            <p class="rdek">{nextPost.data.description}</p>
          </div>
          <div class="rarrow" aria-hidden="true">-&gt;</div>
        </article>
      </nav>
    )
  }

  <script>
    const bar = document.querySelector('[data-progress]');
    const updateProgress = () => {
      if (!bar) return;
      const doc = document.documentElement;
      const max = doc.scrollHeight - doc.clientHeight;
      const progress = max > 0 ? Math.min(1, doc.scrollTop / max) : 0;
      bar.setAttribute('style', `width: ${progress * 100}%`);
    };
    window.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();
  </script>
</BaseLayout>
