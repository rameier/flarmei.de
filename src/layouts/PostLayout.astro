---
import TopicTag from "../components/TopicTag.astro";
import { Image } from "astro:assets";
import type { BlogPost } from "../lib/posts";
import { estimateReadMinutes, formatDate, getPostSlug } from "../lib/posts";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  post: BlogPost;
  nextPost?: BlogPost;
}

const { post, nextPost } = Astro.props;
---

<BaseLayout
  title={`${post.data.title} - flarmei.de`}
  description={post.data.description}
  type="article"
>
  <div class="progress" data-progress></div>
  <article class="fade">
    <header class="post-header">
      <a class="back" href="/blog">&lt;- alle Texte</a>
      <TopicTag topic={post.data.topic} />
      <h1>{post.data.title}</h1>
      <p class="dek">{post.data.description}</p>
      <div class="byline">
        <span class="micro">Ralf Meier</span>
        <time class="micro" datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        <span class="micro">{estimateReadMinutes(post)} min lesen</span>
      </div>
    </header>

    {
      post.data.heroImage && (
        <Image
          class="hero-image"
          src={post.data.heroImage}
          alt={post.data.heroImageAlt ?? post.data.title}
          width={1600}
          height={900}
          fit="cover"
          sizes="(max-width: 860px) 100vw, 748px"
        />
      )
    }

    <hr class="hairline" />

    <div class="article">
      <slot />
    </div>
  </article>

  {
    nextPost && (
      <nav class="post-nav" aria-label="Nächster Artikel">
        <hr class="hairline" />
        <article
          class:list={[
            "row",
            "post-nav-row",
            { "post-nav-row--with-thumb": !!nextPost.data.heroImage },
          ]}
        >
          {nextPost.data.heroImage && (
            <Image
              class="post-nav-thumb"
              src={nextPost.data.heroImage}
              alt={nextPost.data.heroImageAlt ?? nextPost.data.title}
              width={208}
              height={117}
              fit="cover"
              sizes="(max-width: 620px) 100vw, 104px"
            />
          )}
          <div class="rmain">
            <div class="rmeta">
              <span class="micro">NEXT</span>
            </div>
            <h2 class="rtitle">
              <a href={`/blog/${getPostSlug(nextPost)}`}>
                {nextPost.data.title}
              </a>
            </h2>
            <p class="rdek">{nextPost.data.description}</p>
          </div>
          <div class="rarrow" aria-hidden="true">
            -&gt;
          </div>
        </article>
      </nav>
    )
  }

  <script>
    const bar = document.querySelector("[data-progress]");
    const updateProgress = () => {
      if (!bar) return;
      const doc = document.documentElement;
      const max = doc.scrollHeight - doc.clientHeight;
      const progress = max > 0 ? Math.min(1, doc.scrollTop / max) : 0;
      bar.setAttribute("style", `width: ${progress * 100}%`);
    };
    window.addEventListener("scroll", updateProgress, { passive: true });
    updateProgress();

    const article = document.querySelector(".article");
    const sidenotes = article?.querySelectorAll("aside.note");

    sidenotes?.forEach((note) => {
      if (!(note instanceof HTMLElement) || note.dataset.bound === "true") {
        return;
      }

      const previous = note.previousElementSibling;
      if (!(previous instanceof HTMLParagraphElement)) {
        return;
      }

      const pair = document.createElement("div");
      pair.className = "sidenote-pair";
      pair.dataset.position = note.dataset.position ?? "right";

      previous.before(pair);
      pair.append(previous, note);
      note.dataset.bound = "true";
    });
  </script>
</BaseLayout>
