---
interface Layer {
  name: string;
  detail: string;
}

interface Props {
  layers: Layer[];
}

const { layers } = Astro.props;
---

<figure class="abstraction-stack">
  <figcaption>
    <span>Mehr Abstraktion</span>
    <span aria-hidden="true">&uarr;</span>
  </figcaption>
  <ol>
    {
      layers.map((layer, index) => (
        <li
          class:list={{ "is-agent-layer": index === 0 }}
          style={`--layer-inset: ${Math.min(layers.length - index - 1, 5) * 1.5}rem`}
        >
          <strong>{layer.name}</strong>
          <span>{layer.detail}</span>
        </li>
      ))
    }
  </ol>
  <p class="stack-caption">Jede Schicht baut auf den Schichten unter ihr auf.</p>
</figure>
