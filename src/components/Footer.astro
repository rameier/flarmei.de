---
import GithubIcon from './icons/GithubIcon.astro';
import InstagramIcon from './icons/InstagramIcon.astro';
import LinkedinIcon from './icons/LinkedinIcon.astro';

const year = new Date().getFullYear();

const socials = [
  { label: 'GitHub', href: 'https://github.com/rameier', Icon: GithubIcon },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/ralf-meier-88555118a/',
    Icon: LinkedinIcon,
  },
  { label: 'Instagram', href: 'https://www.instagram.com/flarmei.de/', Icon: InstagramIcon },
] as const;
---

<footer class="site-foot">
  <div class="foot-meta">
    <span class="micro">&copy; Ralf Meier · {year}</span>
   
  </div>
   <nav class="legal-links" aria-label="Rechtliches">
      <a href="/kontakt">Kontakt</a>
      <a href="/impressum">Impressum</a>
      <a href="/datenschutz">Datenschutz</a>
    </nav>
  <nav class="socials" aria-label="Soziale Netzwerke">
    {
      socials.map(({ label, href, Icon }) => (
        <a href={href} target="_blank" rel="noopener noreferrer" aria-label={label}>
          <Icon />
        </a>
      ))
    }
  </nav>
</footer>
