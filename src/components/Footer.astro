---
const year = new Date().getFullYear();

const socials = [
  { label: 'GitHub', href: 'https://github.com/rameier', icon: 'github' },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/ralf-meier-88555118a/',
    icon: 'linkedin',
  },
  { label: 'Instagram', href: 'https://www.instagram.com/flarmei.de/', icon: 'instagram' },
] as const;
---

<footer class="site-foot">
  <span class="micro">&copy; Ralf Meier · {year}</span>
  <span class="micro">made with thoughts</span>
  <nav class="socials" aria-label="Soziale Netzwerke">
    {
      socials.map((social) => (
        <a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={social.label}>
          {social.icon === 'github' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 1.8 5.4 2.1 5.4 2.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 8.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V20" />
            </svg>
          )}
          {social.icon === 'linkedin' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="3" y="3" width="18" height="18" rx="2" />
              <path d="M8 11v5M8 8v.01M12 16v-3c0-1.4 1-2.5 2.3-2.5S16.5 11.6 16.5 13v3M12 11v5" />
            </svg>
          )}
          {social.icon === 'instagram' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none" />
            </svg>
          )}
        </a>
      ))
    }
  </nav>
</footer>
