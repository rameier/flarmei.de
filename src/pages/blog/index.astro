---
import { getCollection } from 'astro:content';
import EmptyWriting from '../../components/EmptyWriting.astro';
import PostRow from '../../components/PostRow.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortPosts } from '../../lib/posts';
import { topicOrder, topics } from '../../lib/topics';

const posts = sortPosts(await getCollection('blog'));
---

<BaseLayout
  title="Schreiben - flarmei.de"
  description="Alle Texte von Ralf Meier über Engineering, Führung, Esports und Selbstreflexion."
>
  <header class="page-head fade">
    <span class="micro">Schreiben</span>
    <h1>Texte, die beim Denken helfen sollen.</h1>
  </header>

  <nav class="topic-nav" aria-label="Themen">
    {topicOrder.map((key) => <a href={`/themen/${key}`}>{topics[key].label}</a>)}
  </nav>

  {
    posts.length ? (
      <section class="post-list" aria-label="Alle Texte">
        {posts.map((post) => <PostRow post={post} />)}
      </section>
    ) : (
      <EmptyWriting />
    )
  }
</BaseLayout>
