---
import { getCollection, render } from 'astro:content';
import Callout from '../../components/mdx/Callout.astro';
import Sidenote from '../../components/mdx/Sidenote.astro';
import PostLayout from '../../layouts/PostLayout.astro';
import { getPostSlug, sortPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = sortPosts(await getCollection('blog'));

  return posts.map((post, index) => ({
    params: { slug: getPostSlug(post) },
    props: {
      post,
      nextPost: posts.length > 1 ? posts[(index + 1) % posts.length] : undefined,
    },
  }));
}

const { post, nextPost } = Astro.props;
const { Content } = await render(post);
---

<PostLayout post={post} nextPost={nextPost}>
  <Content components={{ Sidenote, Callout }} />
</PostLayout>
