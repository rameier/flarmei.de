---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Seite nicht gefunden - flarmei.de"
  description="Diese Seite gibt es nicht (mehr)."
>
  <section class="page fade">
    <header class="page-head">
      <span class="micro">404</span>
      <h1>Diese Seite gibt es <em>nicht</em>.</h1>
    </header>

    <p class="lead">
      Der Link war falsch oder die Seite ist umgezogen. Am besten geht es von vorne weiter.
    </p>

    <p>
      <a class="read-link mono" href="/">-&gt; Zurück zur Startseite</a>
    </p>
  </section>
</BaseLayout>
