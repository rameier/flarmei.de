---
import BaseLayout from '../layouts/BaseLayout.astro';

const socials = [
  { label: 'GitHub', href: 'https://github.com/rameier' },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/ralf-meier-88555118a/',
  },
  { label: 'Instagram', href: 'https://www.instagram.com/flarmei.de/' },
] as const;
---

<BaseLayout
  title="Kontakt - flarmei.de"
  description="Kontakt zu Ralf Meier – per E-Mail oder auf einem der sozialen Netzwerke."
>
  <section class="page fade">
    <header class="page-head">
      <span class="micro">Kontakt</span>
      <h1>Schreib mir <em>einfach</em>.</h1>
    </header>

    <p class="lead">
      Der einfachste Weg ist eine E-Mail. Ich antworte nicht sofort, aber ich antworte.
    </p>

    <form class="contact-form" method="post" action="https://kontakt.flarmei.de/contact.php">
      <p class="contact-status" data-contact-status hidden></p>

      <div class="form-row">
        <label for="name">Name</label>
        <input id="name" name="name" type="text" autocomplete="name" required />
      </div>

      <div class="form-row">
        <label for="email">E-Mail</label>
        <input id="email" name="email" type="email" autocomplete="email" required />
      </div>

      <div class="form-row">
        <label for="message">Nachricht</label>
        <textarea id="message" name="message" rows="7" required></textarea>
      </div>

      <div class="contact-trap" aria-hidden="true">
        <label for="website">Website</label>
        <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <input data-started-at name="started_at" type="hidden" value="" />

      <p class="form-note">
        Mit dem Absenden verarbeite ich deine Angaben zur Bearbeitung deiner Anfrage. Weitere
        Informationen findest du in der <a href="/datenschutz">Datenschutzerklärung</a>.
      </p>

      <button class="contact-submit" type="submit">Senden</button>
    </form>

    <dl class="facts">
      {
        socials.map(({ label, href }) => (
          <div class="fact">
            <dt>{label}</dt>
            <dd>
              <a class="fact-link" href={href} target="_blank" rel="noopener noreferrer">
                {href.replace('https://', '')}
              </a>
            </dd>
          </div>
        ))
      }
    </dl>

    <script>
      const startedAt = document.querySelector('[data-started-at]');
      if (startedAt instanceof HTMLInputElement) {
        startedAt.value = String(Math.floor(Date.now() / 1000));
      }

      const status = document.querySelector('[data-contact-status]');
      const params = new URLSearchParams(window.location.search);

      if (status instanceof HTMLElement && params.has('sent')) {
        status.hidden = false;
        status.dataset.state = 'success';
        status.textContent = 'Danke, deine Nachricht ist unterwegs.';
      } else if (status instanceof HTMLElement && params.has('error')) {
        status.hidden = false;
        status.dataset.state = 'error';
        status.textContent = 'Das hat gerade nicht geklappt. Bitte versuch es gleich noch einmal.';
      }
    </script>
  </section>
</BaseLayout>
